# =============================================================================
# Tony-EDWARD v3 — Environment Configuration (Backblaze B2)
# =============================================================================
# Copy to .env for local dev. On Render, set as Environment Variables.
# =============================================================================

# --- Process ---
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production
LOG_LEVEL=INFO

# --- Super-Admin secrets ---
# ADMIN_SECRET_KEY_64: MUST be exactly 64 alphanumeric chars.
ADMIN_SECRET_KEY_64=
SUPER_ADMIN_KEY=
JWT_SECRET=

# --- LLM (Requesty router with auto-failover) ---
PRIMARY_LLM_API_URL=https://router.requesty.ai/v1
PRIMARY_LLM_API_KEY=
PRIMARY_LLM_API_KEY_FALLBACK=
PRIMARY_LLM_MODEL=nemotron-3-ultra-550b-a55b

# --- Backblaze B2 (S3-compatible, 10GB cap) ---
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=tony-edward-patterns
B2_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com
B2_STORAGE_LIMIT_GB=10
B2_REGION=us-east-005

# --- End-user API key registry (bcrypt-hashed) ---
BCRYPT_ROUNDS=12
ENDUSER_ALLOWED_ORIGINS=https://your-frontend.com
ENDUSER_ALLOWED_DOMAINS=your-frontend.com
ENDUSER_RATE_PER_MINUTE=20
ENDUSER_RATE_BURST=5
ENDUSER_MAX_CONCURRENT=4

# --- Storage ---
STORAGE_DIR=/app/storage
AUTO_PURGE_STORAGE_LIMIT_GB=20
AUTO_PURGE_CHECK_INTERVAL_SEC=300
PATTERN_MAX_AGE_DAYS=90
PATTERN_MAX_RECORDS=200000
PATTERN_MIN_NOVELTY_COSINE=0.18

# --- Render API integration ---
RENDER_API_KEY=
RENDER_SERVICE_ID=

# --- 30-day Sandbox Cron ---
SANDBOX_CRON_ENABLED=true
SANDBOX_CRON_INTERVAL_DAYS=30
SANDBOX_ACCURACY_THRESHOLD=0.3
SANDBOX_MIN_PATTERNS_TO_EVAL=50

# --- Scrapers ---
SCRAPER_MIN_DELAY_SEC=2.0
SCRAPER_MAX_DELAY_SEC=5.0
SCRAPER_REQUEST_TIMEOUT_SEC=30
SCRAPER_MAX_RESPONSE_BYTES=5242880
SCRAPER_PLAYWRIGHT_HEADLESS=true

# --- Crypto Checkout (stubbed) ---
CRYPTO_CHECKOUT_ENABLED=false
CRYPTO_CHECKOUT_PROVIDER=manual
